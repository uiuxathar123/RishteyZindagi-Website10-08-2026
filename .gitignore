# --- Dependencies / build output --------------------------------------------
node_modules/
.next/
out/
build/
dist/
coverage/
*.tsbuildinfo
next-env.d.ts.bak

# --- Logs / temp / OS / IDE junk --------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.DS_Store
Thumbs.db
*.swp
*.tmp
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# --- Secrets — never commit real env values ---------------------------------
# Every .env variant is ignored; only the *.example templates are tracked.
.env
.env.*
!.env.example
!.env.test.example
*.pem
*.key
*.p12
*.pfx
id_rsa*
id_ed25519*
secrets/
credentials*.json
service-account*.json

# --- Runtime-generated data -------------------------------------------------
# B14: real pg_dump output from scripts/backup-db.sh — never committed.
/backups/
*.dump
*.sql.gz

# B3/B8: local-disk dev storage adapter's uploaded photos and generated
# invoice PDFs (see src/server/modules/storage). Runtime data, never
# committed; the directory is recreated automatically on first upload.
.storage-local/

# Local database files / data directories
*.db
*.sqlite
*.sqlite3
pgdata/
postgres-data/

# Prisma leftovers (the project uses Drizzle; kept for safety)
prisma/dev.db
prisma/*.db
