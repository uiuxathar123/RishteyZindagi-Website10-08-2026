# Copy this file to `.env.test` (git-ignored) before running `npm test`.
#
# The test suite (tests/setup.ts) loads ONLY this file, and the tests truncate
# tables freely — so DATABASE_URL here MUST point at a SEPARATE, disposable
# database (default name: rishteyzindagi_test), never at your dev database.
#
# Replace every CHANGE_ME value. None of these are real production secrets;
# they are throwaway values for a local test database only.

DATABASE_URL="postgresql://postgres:CHANGE_ME@localhost:5432/rishteyzindagi_test"
NODE_ENV="test"

# Any non-empty string works for tests (used as an HMAC key for session/OTP hashing).
AUTH_SECRET="CHANGE_ME_any_long_random_string_for_tests"
SESSION_TTL_HOURS="720"
APP_URL="http://localhost:3000"
API_URL="http://localhost:3000/api/v1"

# Test-only AES-256-GCM key: exactly 64 hex characters (32 bytes).
# Generate one with:  openssl rand -hex 32
# Needed so the encrypted payment-gateway-credential tests can run.
PAYMENT_CREDENTIALS_ENCRYPTION_KEY="CHANGE_ME_64_hex_chars_from_openssl_rand_hex_32"
