# Copy this file to .env and fill in real values for your environment.
# Never commit the real .env file — it is already in .gitignore.

# --- Core ---------------------------------------------------------------
# PostgreSQL connection string used by Drizzle ORM (src/server/db).
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/rishteyzindagi_dev"
APP_URL="http://localhost:3000"
API_URL="http://localhost:3000/api/v1"
NODE_ENV="development"

# B10: CORS allowlist for the versioned API (read by src/middleware.ts).
# Comma-separated list of exact origins, e.g.
# "https://app.rishteyzindagi.com,https://admin.rishteyzindagi.com" — a
# request's Origin header is only echoed back (allowing the browser call)
# when it exactly matches an entry here. Leave unset/empty to allow every
# origin (the pre-B10 behavior, and this sandbox's default — no real app/
# admin origin exists yet). See src/middleware.ts's file comment.
ALLOWED_ORIGINS=""

# --- Auth / sessions ------------------------------------------------------
# Used to hash device-session tokens at rest (HMAC key), not a JWT signing
# key — session tokens themselves are opaque random values, never JWTs, so
# there is nothing to forge even if this leaks; treat it as a secret anyway.
AUTH_SECRET="replace-with-a-long-random-value"
SESSION_TTL_HOURS="720"

# --- Dev-only seed account (see src/server/db/seed.ts) --------------------------
# Only used when NODE_ENV=development AND SEED_DEV_SUPER_ADMIN=true. Never
# set this in staging/production — B1 does not seed a default admin
# password into any environment by default.
SEED_DEV_SUPER_ADMIN="false"
SEED_DEV_SUPER_ADMIN_EMAIL="dev-superadmin@rishteyzindagi.local"
SEED_DEV_SUPER_ADMIN_PASSWORD=""

# --- OTP delivery providers (B2) -----------------------------------------
# SUPERSEDED by the "Production completion" section at the bottom of this
# file: OTP delivery is now Email (SMTP_*) or Fast2SMS SMS (FAST2SMS_*), with
# exactly one active at a time (admin: Platform Settings -> OTP delivery
# provider). The legacy *_PROVIDER / *_API_KEY variables below are still read
# by the original provider scaffolds, are NOT needed for the new providers,
# and may be left blank.
EMAIL_PROVIDER=""
EMAIL_API_KEY=""

SMS_PROVIDER=""
SMS_API_KEY=""

WHATSAPP_PROVIDER=""
WHATSAPP_API_KEY=""

# --- Push notification provider (B7) --------------------------------------
# Read by src/server/modules/notifications/providers/push.provider.ts —
# same isConfigured()-at-request-time posture as the OTP channels above.
# No real push vendor SDK is wired in yet; leave blank until one is.
PUSH_PROVIDER=""
PUSH_API_KEY=""

# --- Storage provider (B3) -------------------------------------------------
# Read by src/server/modules/storage/factory.ts. Unset or "local" uses the
# local-disk dev adapter (.storage-local/, never a real deployment store).
# "s3" selects the S3-compatible provider (AWS S3, Cloudflare R2, MinIO,
# DigitalOcean Spaces...) configured by the S3_* variables at the bottom.
# Any other value fails loudly rather than falling back to local disk.
STORAGE_PROVIDER=""
STORAGE_BUCKET=""

# --- Payment-gateway credential encryption (B8) -----------------------------
# AES-256-GCM key (64-char hex = 32 raw bytes) used to encrypt payment
# gateway credentials at rest in payment_gateways.config (see
# src/server/lib/crypto.ts). Required before any real gateway credential
# can be saved via PATCH /admin/payment-gateways/:id — gateway-config
# .service.ts throws ServiceUnavailableError rather than ever storing a
# real credential in plaintext if this is unset. Generate a real one with
# `openssl rand -hex 32`; never reuse the dev/test value across environments.
PAYMENT_CREDENTIALS_ENCRYPTION_KEY=""

# --- Payment gateway credentials (B8) ---------------------------------------
# Razorpay and PhonePe are the two supported gateways (exactly one active,
# chosen in Platform Settings -> Payment gateway). Credentials may be saved
# encrypted from that admin screen OR supplied here; see the PCP section at
# the bottom for the full list (webhook secrets, PhonePe client id/secret...).
# The CASHFREE/PAYU/PAYTM entries are legacy placeholders from B8 and are not
# usable gateways.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
CASHFREE_APP_ID=""
CASHFREE_SECRET_KEY=""
PAYU_MERCHANT_KEY=""
PAYU_SALT=""
PHONEPE_MERCHANT_ID=""
PHONEPE_SALT_KEY=""
PAYTM_MERCHANT_ID=""
PAYTM_MERCHANT_KEY=""

# --- Invoicing / tax (B8) ---------------------------------------------------
# GST rate (%) applied to INR invoices' tax line (see invoice-pdf.ts /
# tax-config.ts) — a configurable placeholder, not asserted as legally
# authoritative for this business; confirm the real applicable rate
# before a real launch. Non-INR invoices always use 0% (see BACKEND.md's
# B8 section). Defaults to 18 if unset.
GST_RATE_PERCENT="18"

# --- B16: frontend <-> backend integration -------------------------------
# The browser never talks to /api/v1 directly: it calls the same-origin
# session proxy under /bff/*, which keeps the session token in an httpOnly
# cookie (rz_session for members, rz_admin_session for admins) and forwards
# to the API. By default the proxy calls itself on http://127.0.0.1:<PORT>.
# Set this only if the app is reachable on a different internal address
# (e.g. behind a reverse proxy / container networking). No secret.
INTERNAL_API_ORIGIN=""

# Public contact e-mail shown on /contact and in the footer. Leave empty and
# the site shows no e-mail address rather than inventing one. Not a secret.
NEXT_PUBLIC_SUPPORT_EMAIL=""

# =============================================================================
# Production completion (PCP). PLACEHOLDERS ONLY - never commit real values.
# Run `npm run check:prod-env` before every deployment.
# =============================================================================

# --- Payments ----------------------------------------------------------------
# Only used OUTSIDE production: "real" makes a dev/staging server call the real
# (sandbox) gateway APIs; unset/"dev" uses the built-in mock gateway. In
# production the real adapters are always used and this value is ignored.
# PAYMENT_PROVIDER_MODE="real"     # <- uncomment for Razorpay TEST-mode checkout on your machine
# Minutes an unpaid PENDING order lives before the reconcile job closes it
# (only after the gateway confirms it is unpaid). Default 60.
PAYMENT_PENDING_EXPIRY_MINUTES="60"
# Razorpay (https://dashboard.razorpay.com -> Settings -> API Keys / Webhooks).
# LOCAL TEST-MODE SETUP (see PROVIDER_TEST_SETUP.md): set RAZORPAY_KEY_ID / RAZORPAY_KEY_SECRET (further up) to the
# dashboard's TEST-mode key pair (key id starts rzp_test_) and PAYMENT_PROVIDER_MODE="real" above. Key-mode guard:
# production refuses anything that is not an rzp_live_ key; every other environment refuses rzp_live_ keys.
# Optional: only needed to RECEIVE Razorpay webhooks (the checkout flow itself does not depend on them).
RAZORPAY_WEBHOOK_SECRET=""
# RAZORPAY_API_BASE=""          # leave unset in production (https://api.razorpay.com)
# PhonePe Business (Payment Gateway v2: client id / secret / version).
PHONEPE_CLIENT_ID=""
PHONEPE_CLIENT_SECRET=""
PHONEPE_CLIENT_VERSION="1"
PHONEPE_ENV="production"        # or sandbox
PHONEPE_WEBHOOK_USERNAME=""     # the username/password you set on the PhonePe webhook
PHONEPE_WEBHOOK_PASSWORD=""
# PHONEPE_API_BASE= / PHONEPE_AUTH_BASE=   # test doubles only; leave unset

# --- OTP delivery ------------------------------------------------------------
# Email OTP (SMTP). EMAIL_FROM must be a sender your SMTP relay accepts.
# Local: Admin -> Platform Settings -> OTP delivery provider = E-mail, and turn OFF "dev mode" in the OTP settings,
# otherwise codes are kept in memory and never e-mailed. Verify with: npm run check:providers -- --to you@example.com
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"             # true for implicit TLS (port 465)
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM=""
# Fast2SMS SMS OTP (https://www.fast2sms.com -> Dev API). Delivery only: codes
# are generated and verified by this platform.
FAST2SMS_API_KEY=""
FAST2SMS_OTP_ID=""              # REQUIRED for SMS OTP: the OTP template id from your Fast2SMS account
# FAST2SMS_API_BASE=""          # test doubles only

# --- WhatsApp / push notifications (optional; fail safely when unset) ----------
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_TEMPLATE_NAME=""
FCM_PROJECT_ID=""
FCM_CLIENT_EMAIL=""
FCM_PRIVATE_KEY="replace-me-with-your-fcm-private-key"

# --- Object storage (S3-compatible; STORAGE_PROVIDER="s3") ---------------------
# Bucket is STORAGE_BUCKET above. Objects are private; the app hands out
# short-lived (<=15 min) signed URLs. https is required in production.
S3_ENDPOINT=""                  # e.g. https://<account>.r2.cloudflarestorage.com ; blank = AWS
S3_REGION="auto"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_FORCE_PATH_STYLE="false"     # true for MinIO and some S3 clones

# --- Rate limiting / proxy / jobs -------------------------------------------------
# Number of trusted reverse proxies in front of the app. MUST be set correctly
# behind nginx/Cloudflare/ALB (1 = one proxy). With 0 the left-most
# X-Forwarded-For value is used, which a client can forge unless your edge
# overwrites the header.
TRUST_PROXY_HOPS="1"
# "postgres" (default; shared across instances) or "memory" (single process).
# RATE_LIMIT_STORE="postgres"
# Shared secret (>= 32 chars) for POST/GET /api/v1/internal/jobs/<job>.
# Unset => the HTTP trigger returns 404 (use `npm run job -- <name>` instead).
# Generate: openssl rand -hex 32
CRON_SECRET=""

# --- Live chat stream (B19, Server-Sent Events; both optional) -----------------
# How often an open chat stream looks for new messages, and how long one connection lives before the browser reconnects.
# CHAT_STREAM_POLL_MS="1500"
# CHAT_STREAM_MAX_LIFETIME_MS="55000"

# --- Account deletion ---------------------------------------------------------
ACCOUNT_RECOVERY_WINDOW_DAYS="30"

# --- Content-Security-Policy (read at BUILD time by next.config.js) -----------------
# Extra https origins allowed to serve images (e.g. the CDN/bucket host that
# serves member photos), space separated.
# CSP_IMG_SRC_EXTRA="https://photos.example.com"

# --- Backups (read by scripts/backup-secure.sh, backup-offsite.ts, verify-restore.sh) --
# BACKUP_DIR="/var/backups/rishteyzindagi"
# BACKUP_ENCRYPTION="passphrase"          # passphrase | recipient | none
# BACKUP_PASSPHRASE_FILE="/etc/rishteyzindagi/backup.pass"   # chmod 600, >= 16 chars
# BACKUP_GPG_RECIPIENT=""                 # when BACKUP_ENCRYPTION=recipient
# BACKUP_OFFSITE="s3"                     # none | dir | s3
# BACKUP_OFFSITE_DIR=""                   # when BACKUP_OFFSITE=dir (e.g. a mounted remote volume)
# BACKUP_S3_BUCKET="" BACKUP_S3_REGION="" BACKUP_S3_ENDPOINT="" BACKUP_S3_PREFIX=""
# BACKUP_S3_ACCESS_KEY_ID="" BACKUP_S3_SECRET_ACCESS_KEY="" BACKUP_S3_FORCE_PATH_STYLE="false"
# VERIFY_ADMIN_DATABASE_URL=""            # a role allowed to CREATE/DROP DATABASE, for restore verification
